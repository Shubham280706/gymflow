# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Razorpay (leave empty to skip payment links; "Mark paid (cash)" still works)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Shared secret used by n8n / Vercel Cron to call /api/cron/* and /api/automation/*
CRON_SECRET=change-me-to-a-long-random-string

# Public URL of this app (used in logs / links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
